{
  "name": "call-calendar",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter api --filter web dev",
    "generate": "pnpm --filter api generate && pnpm --filter web generate",
    "lint": "eslint . && pnpm --filter api typecheck && pnpm --filter web typecheck",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter e2e test:e2e"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1"
  },
  "version": "1.3.1"
}
